{
  "name": "sharpner",
  "private": true,
  "description": "A shared infinite canvas for people and coding agents, built on Cloudflare.",
  "license": "MIT",
  "packageManager": "pnpm@11.17.0",
  "engines": { "node": ">=24" },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "vite build && wrangler d1 migrations apply sharpner --remote && wrangler deploy",
    "db:migrate": "wrangler d1 migrations apply sharpner --local",
    "typecheck": "pnpm cf-typegen && tsc --noEmit",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings --strict-vars=false",
    "test": "vitest run --maxWorkers=4",
    "test:stress": "vitest run src/canvas-layout.stress.test.ts --mode stress --maxWorkers=1"
  },
  "dependencies": {
    "@clerk/backend": "3.26.4",
    "@clerk/react": "6.18.3",
    "@cloudflare/puppeteer": "^1.4.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@tabler/icons-react": "^3.50.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "hono": "^4.13.14",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "4.3.3",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.65.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "shadcn": "^4.23.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "4.1.10",
    "wrangler": "^4.154.0"
  }
}
