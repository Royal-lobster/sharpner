# A render host for Sharpner: Chromium and the host program, with nothing of the machine it runs on.
# Build and run it with ./run.sh, which sets the limits this image relies on.
FROM docker.io/library/node:24-trixie-slim
RUN apt-get update \
 && apt-get install -y --no-install-recommends chromium-headless-shell ca-certificates nftables util-linux tini \
      fonts-liberation fonts-dejavu-core fonts-noto-core fonts-noto-cjk fonts-noto-color-emoji \
 && rm -rf /var/lib/apt/lists/* \
 # The host program runs as `node` (1000); Chromium runs as a user of its own, which owns nothing.
 && groupadd --gid 1001 chrome && useradd --uid 1001 --gid 1001 --no-create-home --shell /usr/sbin/nologin chrome
COPY render-host.mjs entrypoint.sh /opt/render-host/
RUN chmod 0555 /opt/render-host/entrypoint.sh /opt/render-host/render-host.mjs
ENV CHROME_BIN=/usr/bin/chromium-headless-shell RENDER_HOST_CHROME_USER=1001
ENTRYPOINT ["/usr/bin/tini", "--", "/opt/render-host/entrypoint.sh"]
