# Use a dedicated Sharpner Clerk application with Organizations enabled and Personal Accounts disabled.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Subscribe /auth/webhook to user, organization and organizationMembership events.
CLERK_WEBHOOK_SIGNING_SECRET=
# Optional registered public OAuth client for local agents. Register matching loopback callback URLs.
CLERK_MCP_CLIENT_ID=
CLERK_MCP_CALLBACK_PORT=
# Set to 1 only after enabling Clerk's API Keys feature; hidden by default.
CLERK_API_KEYS_ENABLED=
# Optional HTTPS origin for the hosted app; browser file links on older hosts open here.
APP_ORIGIN=
# Optional mention email through Resend. Without both, tagged members are notified in the app only.
# EMAIL_FROM is a sender on a domain verified with Resend, e.g. "Sharpner <notify@example.com>".
RESEND_API_KEY=
EMAIL_FROM=
